[Unit]
Description=CFA635 LCD page server
After=dev-cfa635.device
BindsTo=dev-cfa635.device

[Service]
User=cfa635
SupplementaryGroups=dialout
Environment=CFA635_PORT=/dev/cfa635
WorkingDirectory=/opt/cfa635
ExecStart=/opt/cfa635/.venv/bin/cfa635-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
